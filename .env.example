# Copy to root .env.platform; dev:platform loads only that file.
# Fictional, loopback-only development infrastructure credentials.
PLATFORM_DATABASE_URL=postgresql://companion:local-companion-dev-only@127.0.0.1:5442/companion
PLATFORM_DATABASE_POOL_MAX=12
PLATFORM_DATABASE_CONNECT_TIMEOUT_MS=5000
# API and worker must use the same immutable release identifier in production.
# Replace this development value with the chosen commit or image digest (bare hex).
PLATFORM_BUILD_ID=development
PLATFORM_REDIS_URL=redis://:local-companion-redis-only@127.0.0.1:6388/0
PLATFORM_STORAGE_DIR=.local/platform/blobs
PLATFORM_PORT=4320
PLATFORM_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:4320,http://127.0.0.1:4320
PLATFORM_ALLOW_PROVIDER_CALLS=0
# Internal task workbench, independent of model calls/approvals. Defaults closed.
# Set to 1 only for non-production internal development; production employee
# workbench access is not wired, so production rejects 1. Saved execution checks still apply.
PLATFORM_ENABLE_WORKBENCH=0
# Student registration requires email-bound, single-use invitations by default.
# Explicit 0 is development-only; production rejects 0. Consent has no bypass flag.
PLATFORM_REQUIRE_INVITE=1
# Operator-supplied approved documents must also match the active database policy.
# No document, invitation or consent is issued by startup; missing content closes admission.
# PLATFORM_LEGAL_BUNDLE_FILE=.local/platform/legal/current.json
# HTTP chat/voice routing is server-owned; clients cannot select provider/model.
# These bindings do not enable model calls; leave unused purposes unbound.
# Models come from the bound provider's existing server configuration below.
# PLATFORM_CHAT_PROVIDER=openai
# PLATFORM_AGENT_PROVIDER=openai
# PLATFORM_REALTIME_PROVIDER=openai
# PLATFORM_TRANSCRIPTION_PROVIDER=openai
# PLATFORM_SPEECH_PROVIDER=openai
# Internal intake safety classification has no chat-model fallback. These are intentionally unconfigured.
# PLATFORM_SAFETY_CLASSIFY_PROVIDER=openai
# PLATFORM_COMPANION_GENERATION_PROVIDER=openai
# PLATFORM_FIRST_LETTER_PROVIDER=openai
# PLATFORM_SAFETY_PROFILE_FILE=.local/private/reviewed-safety-profile.json
# Server-only externally reviewed fixed responses/resources. No clinical content or activation is seeded.
# PLATFORM_SAFETY_RESPONSE_BUNDLE_FILE=.local/private/reviewed-safety-responses.json
# Separate externally reviewed body/question delivery manifest; loading it does not activate a release.
# PLATFORM_SAFETY_DELIVERY_REVIEW_FILE=.local/private/reviewed-safety-delivery.json
# Optional internal identity vocabulary/character bundle; integrity validation does not grant release approval.
# PLATFORM_COMPANION_IDENTITY_BUNDLE_FILE=.local/private/companion-identity.json
# Matching external human-review manifest; no vocabulary or activation is seeded.
# PLATFORM_COMPANION_IDENTITY_REVIEW_FILE=.local/private/companion-identity-review.json
# Optional offline seal outlines. Set all six fields together from a separately built server artifact.
# The glyph file must be owner-controlled (0600 in a 0700 directory); hashes are lowercase SHA-256.
# Availability does not activate naming review or student release. No glyph pack is supplied here.
# PLATFORM_COMPANION_SEAL_GLYPH_FILE=.local/private/companion-seal-glyphs.json
# PLATFORM_COMPANION_SEAL_GLYPH_ASSET_SHA256=
# PLATFORM_COMPANION_SEAL_GLYPH_FILE_SHA256=
# PLATFORM_COMPANION_SEAL_FONT_SHA256=
# PLATFORM_COMPANION_SEAL_BUILDER_SHA256=
# PLATFORM_COMPANION_SEAL_DOMAIN_SHA256=
PLATFORM_SAFETY_DAILY_MODEL_CALL_LIMIT=0
# Effective only in explicit development + internal workbench mode; no staff role or override.
PLATFORM_EXPOSE_PROVIDER_DETAILS=0

# Account email is separately opt-in; localhost never sends mail by default.
# Production requires configured email and verified accounts before workspace access.
PLATFORM_ALLOW_ACCOUNT_EMAIL=0
RESEND_API_KEY=
PLATFORM_ACCOUNT_EMAIL_FROM=
PLATFORM_ACCOUNT_WEB_ORIGIN=
# Dedicated 32-byte AES-GCM key as 64 hex characters, shared by API and worker.
# Keep this key in private server secrets; never put it in VITE_* or source.
PLATFORM_ACCOUNT_EMAIL_ENCRYPTION_KEY=
# Optional in development only: PLATFORM_REQUIRE_VERIFIED_EMAIL=1

# Private intake encryption: production requires a separate 32-byte key as 64 hex characters.
# API and worker must share the same private value; do not reuse the account-email key.
# Leave unset in development until configured. An explicit empty value is invalid.
# PLATFORM_DATA_KEY=

# Public web build configuration only. Empty keeps the same-origin localhost API.
# A split deployment uses an exact API HTTPS origin on the same site as the web;
# no keys or credentials belong in any VITE_* value.
VITE_PLATFORM_API_ORIGIN=

# Configure only providers you intend to use. Model names/endpoint IDs must be
# available in your own developer account. Keys never go into VITE_* variables.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# An explicit Structured Outputs-compatible model is required; no default or paid fallback.
OPENAI_SAFETY_CLASSIFY_MODEL=
# Explicit internal generation model; never falls back to the chat model.
OPENAI_COMPANION_GENERATION_MODEL=
# Separate first-letter generation model; no preview/chat fallback or automatic enablement.
OPENAI_FIRST_LETTER_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_REALTIME_MODEL=
# Separate optional WebRTC input transcription model; check account compatibility.
OPENAI_REALTIME_TRANSCRIBE_MODEL=
# Existing server-reviewed ElevenLabs voice; no recording upload or training is automated.
# Explicit model: eleven_v4, eleven_v3, eleven_multilingual_v2 or eleven_flash_v2_5.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_TTS_VOICE_ID=
# Default requests Zero Retention Mode, which requires Enterprise access.
# Set 1 only after explicitly accepting provider history retention for this service.
ELEVENLABS_ALLOW_PROVIDER_HISTORY=0
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
ARK_API_KEY=
ARK_CHAT_MODEL=
ARK_VIDEO_MODEL=
FAL_KEY=
FAL_IMAGE_ENDPOINT=
FAL_VIDEO_ENDPOINT=

# Existing local models only; no automatic model download.
# Example: http://127.0.0.1:11434/v1 and a model reported by local ollama list.
# Verify the Ollama server has cloud disabled; platform's commercial gate does
# not change the configuration of an already-running Ollama process.
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=
# Optional server setting: none|low|medium|high; unset preserves model defaults.
# Qwen3.5 treats non-none values as thinking enabled, not distinct budgets.
OLLAMA_REASONING_EFFORT=
# Optional local English speech; prepare weights explicitly before starting it.
# See services/local-speech/README.md. Requests never download models.
# Example base: http://127.0.0.1:8880/v1, model: kokoro-82m, voice: af_heart.
KOKORO_BASE_URL=
KOKORO_TTS_MODEL=
KOKORO_TTS_VOICE=
# Optional offline audio transcription; explicit setup downloads fixed tiny assets.
# Example base: http://127.0.0.1:8881/v1, model: whisper-tiny.
# See services/local-transcription/README.md. This is not realtime voice.
FASTER_WHISPER_BASE_URL=
FASTER_WHISPER_MODEL=
COMFYUI_BASE_URL=
COMFYUI_WORKFLOW_TEMPLATE=
# Required for a configured workflow: image|video. One captured template declares
# one output kind; its kind is included in the reviewed version hash.
COMFYUI_OUTPUT_KIND=
COMFYUI_PROMPT_NODE=
COMFYUI_PROMPT_FIELD=text

# Browser reading, reviewed actions and isolated coding harness stay off until configured.
PLATFORM_ENABLE_BROWSER=0
PLATFORM_ENABLE_BROWSER_ACTIONS=0
# Exact loopback origins for fictional local browser fixtures only; empty by default.
PLATFORM_BROWSER_ALLOWED_ORIGINS=
PLATFORM_ENABLE_CLI=0
PLATFORM_CLI_IMAGE=
PLATFORM_CLI_COMMAND=
PLATFORM_CLI_NETWORK=none
PLATFORM_CLI_MODEL_RELAY=0
# Explicit opt-in only for reviewed harnesses already isolated by the Docker runner.
PLATFORM_CLI_EXTERNAL_SANDBOX=0
PLATFORM_CLI_MODEL=
# Conservative byte-based input plus capped output reservations, not dollar pricing.
PLATFORM_CLI_RELAY_MAX_REQUESTS=16
PLATFORM_CLI_RELAY_MAX_TOKENS=131072
PLATFORM_CLI_RELAY_DAILY_TOKENS=524288
PLATFORM_CLI_RELAY_MAX_OUTPUT_TOKENS=4096

# MCP stays unconfigured by default. Set only an explicit private server catalog.
# No empty assignment: PLATFORM_MCP_CATALOG_FILE requires an existing JSON file.
# Optional: PLATFORM_MCP_CATALOG_FILE=/private/server/reviewed-mcp-catalog.json
# PLATFORM_MCP_FIXTURE_ORIGINS is non-production loopback testing only.
# See docs/platform/mcp.md; service credentials never belong in VITE_*.

# Optional private S3-compatible object storage; provision a private bucket first.
PLATFORM_S3_BUCKET=
PLATFORM_S3_ENDPOINT=
PLATFORM_S3_REGION=us-east-1
PLATFORM_S3_ACCESS_KEY_ID=
PLATFORM_S3_SECRET_ACCESS_KEY=
