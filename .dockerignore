# Only independent platform sources can enter this build context.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!packages/
!packages/platform-contracts/
!packages/platform-contracts/**
!packages/ai-core/
!packages/ai-core/**
!packages/career-core/
!packages/career-core/**
!apps/
!apps/web/
!apps/web/**
!services/
!services/platform-api/
!services/platform-api/**
!infra/
!infra/platform/
!infra/platform/production/
!infra/platform/production/**
**/node_modules
**/dist
**/test
**/tests
**/.local
**/.env
**/.env.*
**/*.tsbuildinfo
**/.DS_Store
infra/platform/production/README.md
infra/platform/production/*.yaml

# Private verification and runtime state never enter the Docker context.
**/.runtime
**/.cache
**/.git
**/coverage
