        "c_b",
        "c_b2"
      ]
    ],
    "rowOrdinals": {
      "c_a": 0,
      "c_b": 1,
      "c_b2": 1
    },
    "observedEpochs": {
      "c_a": [
        0,
        2
      ],
      "c_b": [
        0,
        0
      ],
      "c_b2": [
        2,
        2
      ]
    }
  }
