{
  "name": "@companion/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker-main.ts",
    "migrate": "tsx src/migrate.ts",
    "operations": "tsx src/operations-main.ts",
    "eval:plan": "tsx evals/main.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@companion/ai-core": "workspace:*",
    "@companion/career-core": "workspace:*",
    "@companion/platform-contracts": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.5",
    "@modelcontextprotocol/client": "2.3.1",
    "@resvg/resvg-js": "2.6.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bullmq": "^5.61.0",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
