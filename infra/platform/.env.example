PLATFORM_DATABASE_URL=postgresql://companion:local-companion-dev-only@127.0.0.1:5442/companion
PLATFORM_REDIS_URL=redis://:local-companion-redis-only@127.0.0.1:6388/0
PLATFORM_STORAGE_DIR=.local/platform/blobs
PLATFORM_PORT=4320
PLATFORM_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:4320,http://127.0.0.1:4320
# New general-workbench tasks are disabled. Explicit 1 is for internal non-production development only.
# Production rejects 1 until employee workbench access is wired. Saved execution checks still apply.
PLATFORM_ENABLE_WORKBENCH=0
# Default on; explicit 0 is development-only. All environments still require current consent.
PLATFORM_REQUIRE_INVITE=1
# Operator-approved, server-only documents must match the active database policy.
# PLATFORM_LEGAL_BUNDLE_FILE=.local/platform/legal/current.json
# HTTP chat/voice routing is server-owned; public capabilities expose booleans.
# Provider model configuration and paid-call permission remain separate.
# PLATFORM_CHAT_PROVIDER=openai
# PLATFORM_AGENT_PROVIDER=openai
# PLATFORM_REALTIME_PROVIDER=openai
# PLATFORM_TRANSCRIPTION_PROVIDER=openai
# PLATFORM_SPEECH_PROVIDER=openai
# Effective only in explicit development + workbench mode, without staff authorization.
PLATFORM_EXPOSE_PROVIDER_DETAILS=0
# Private intake storage requires a separate 32-byte key encoded as 64 hex characters.
# Production requires it; API and worker must share the same private value.
# Leave unset in development. An explicit empty value is invalid; never reuse the email key.
# PLATFORM_DATA_KEY=
# Optional S3-compatible storage. Create private bucket separately; never expose credentials in browser.
# PLATFORM_S3_ENDPOINT=http://127.0.0.1:9010
# PLATFORM_S3_BUCKET=companion-private
# PLATFORM_S3_REGION=us-east-1
# PLATFORM_S3_ACCESS_KEY_ID=local-companion
# PLATFORM_S3_SECRET_ACCESS_KEY=local-companion-minio-only

# Explicit opt-in for enum-only product events in our database (no external analytics).
PLATFORM_PRODUCT_EVENTS_ENABLED=0
